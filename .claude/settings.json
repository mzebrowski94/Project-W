{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/verify.sh:*)",
      "Bash(.claude/scripts/gradle.sh:*)",
      "Bash(.claude/scripts/cloud-commit.sh:*)",
      "Bash(./gradlew:*)",
      "Bash(git restore -- docs/*)",
      "Bash(git restore -- .scratch/*)",
      "Bash(git -C .claude/worktrees/* commit *)",
      "Bash(git -C .claude/worktrees/integration merge *)",
      "Bash(git -C . merge *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git -C *..* commit *)",
      "Bash(git -C *..* merge *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
