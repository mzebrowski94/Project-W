{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/verify.sh:*)",
      "Bash(.claude/scripts/gradle.sh:*)",
      "Bash(.claude/scripts/cloud-commit.sh:*)",
      "Bash(./gradlew:*)",
      "Bash(git restore -- docs/*)",
      "Bash(git restore -- .scratch/*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
